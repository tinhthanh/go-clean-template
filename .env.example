# App
APP_NAME=go-clean-template
APP_VERSION=1.0.0
# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=*
# HTTP settings
HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false
# Logger
LOG_LEVEL=debug
# PG
PG_POOL_MAX=2
PG_URL=postgres://user:myAwEsOm3pa55%40w0rd@localhost:5432/db
# gRPC
GRPC_ENABLED=true
GRPC_PORT=8081
# RMQ
RMQ_ENABLED=true
RMQ_RPC_SERVER=rpc_server
RMQ_RPC_CLIENT=rpc_client
RMQ_URL=amqp://guest:guest@localhost:5672/
# NATS
NATS_ENABLED=true
NATS_RPC_SERVER=rpc_server
NATS_URL=nats://guest:guest@localhost:4222/
# Metrics
METRICS_ENABLED=true
# Swagger
SWAGGER_ENABLED=true
# Tracing
TRACING_ENABLED=true
TRACING_OTLP_ENDPOINT=localhost:4317
TRACING_OTLP_INSECURE=true
TRACING_SAMPLE_RATE=1.0
# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_TOKEN_EXPIRY=24h
# Rate limit, per client
RATE_LIMIT_EXPIRATION=1m
RATE_LIMIT_MAX=100
